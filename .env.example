DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/doppelganger
MATCHING_ENABLED=true
FACE_PROVIDER=app.opencv_provider:create_provider
FACE_MODEL_PATH=/app/models
FACE_EMBEDDING_DIM=128
FACE_MODEL_VERSION=yunet-2023mar+sface-2021dec
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
IMAGE_MAX_SIDE=1600
SESSION_COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DEPLOYMENT_ENVIRONMENT=development
EXPERIMENT_VARIANT=control
LOG_LEVEL=INFO
SELF_SIMILARITY_THRESHOLD=0.55
CONSENTED_STORAGE_ENABLED=false
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DATA_ENCRYPTION_KEY=replace-with-a-fernet-key
DATA_ENCRYPTION_KEY_VERSION=v1
RETAINED_UPLOAD_DAYS=30
RETAINED_IMAGE_MAX_SIDE=1024
CONSENT_TEXT_VERSION=2026-11-06
MATCH_NARRATION_ENABLED=false
# OPENAI_API_KEY=replace-in-local-env-or-render-secret
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=12
# Choose either the one-time setup page via BOOTSTRAP_SECRET or both initial-admin values.
# BOOTSTRAP_SECRET=replace-with-at-least-32-random-characters
# INITIAL_ADMIN_EMAIL=you@example.com
# INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
